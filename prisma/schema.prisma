// Multi-tenant ecommerce — Phase 1–3
// Future: Customer accounts, production WebPay hardening

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tagline   String?
  about     String?
  /// Hex brand color, e.g. #00B1E2
  primaryColor   String  @default("#00B1E2")
  secondaryColor String  @default("#12326E")
  logoUrl        String?
  phone          String?
  phoneSecondary String?
  email          String?
  whatsapp       String?
  address        String?
  city           String?
  region         String?
  /// Top bar: zonas de despacho
  deliveryBanner String?
  /// Top bar: horarios
  hoursBanner    String?
  /// Hero (legacy single-image fields; prefer heroSlides)
  heroImageUrl   String?
  heroHeadline   String?
  heroBody       String?
  /// Carrusel de inicio: [{ id, imageUrl, title?, subtitle?, ctaLabel?, ctaHref? }]
  heroSlides     Json?
  /// Feature flags storefront: descuentos, planes, kits, redes, certificaciones, loginClientes, selectorRegion, hogarEmpresa
  modulesEnabled Json?
  /// Contenido editable de módulos (regiones, ofertas, planes, kits, redes, certs, copy hogar/empresa)
  modulesContent Json?
  /// Footer coverage blurb
  coverageText   String?
  facebookUrl    String?
  instagramUrl   String?
  twitterUrl     String?
  youtubeUrl     String?
  /// Apariencia (overrides validados en src/lib/appearance.ts): colores tienda/panel, favicon, login admin
  appearance     Json?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  adminUsers        AdminUser[]
  customers         Customer[]
  products          Product[]
  deliveryZones     DeliveryZone[]
  orders            Order[]
  webpayCredential  WebPayCredential?
  deliveryRoutes    DeliveryRoute[]
  deliveryCustomers DeliveryCustomer[]
  orderEvents       OrderEvent[]
  bottleMovements   BottleMovement[]

  @@map("tenants")
}

/// Buyer accounts (optional module loginClientes)
model Customer {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

/// Per-tenant WebPay Plus credentials (API key encrypted at rest)
model WebPayCredential {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  commerceCode    String
  /// AES-GCM ciphertext (base64url)
  apiKeyEncrypted String
  /// integration | production
  environment     String   @default("integration")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("webpay_credentials")
}

model AdminUser {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         String   @default("admin") // admin | super_admin (future)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("admin_users")
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  /// Price in Chilean pesos (CLP), whole pesos
  priceClp    Int
  imageUrl    String?
  /// Optional stock; null = not tracked
  stock       Int?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
  @@map("products")
}

model DeliveryZone {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  /// Comunas covered, comma-separated stub
  communes    String
  /// Delivery cost in CLP; 0 = gratis
  costClp     Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId])
  @@map("delivery_zones")
}

/// pending → paid/failed/cancelled via WebPay commit
model Order {
  id               String   @id @default(cuid())
  tenantId         String
  deliveryZoneId   String?
  status           String   @default("pending") // pending | paid | failed | cancelled
  customerName     String
  customerPhone    String
  customerAddress  String
  customerNotes    String?
  /// Snapshot of zone name at order time
  deliveryZoneName String?
  subtotalClp      Int
  shippingClp      Int      @default(0)
  totalClp         Int
  /// Transbank buy_order (≤26 chars, unique per commerce)
  buyOrder         String?
  webpayToken      String?
  webpayStatus     String?
  webpayResponseCode Int?
  webpayAuthorizationCode String?
  webpayPaymentTypeCode   String?
  webpayCardLast4  String?
  /// mock | sandbox
  paymentProvider  String?
  paidAt           DateTime?
  /// Despacho: por_asignar | programado | en_ruta | entregado | no_entregado
  fulfillmentStatus String   @default("por_asignar")
  deliveryCommune   String?
  deliveryDate      DateTime? @db.Date
  /// manana | tarde
  deliverySlot      String?
  routeId           String?
  routeStop         Int?
  deliveryCustomerId String?
  dispatchNotes     String?
  bottlesDelivered  Int?
  bottlesReturned   Int?
  scheduledAt       DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  route        DeliveryRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  deliveryCustomer DeliveryCustomer? @relation(fields: [deliveryCustomerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       OrderEvent[]
  bottleMovements BottleMovement[]

  @@unique([tenantId, buyOrder])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([webpayToken])
  @@index([tenantId, fulfillmentStatus])
  @@index([tenantId, deliveryDate])
  @@index([routeId])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String?
  /// Snapshot fields so catalog edits don't rewrite history
  productName  String
  productSlug  String
  unitPriceClp Int
  quantity     Int
  lineTotalClp Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

/// Apex SaaS landing CMS (mibidon.cl). One row per landing block; content validated by src/lib/landing/schema.ts
model PlatformLandingSection {
  key       String   @id
  enabled   Boolean  @default(true)
  content   Json
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt

  @@map("platform_landing_sections")
}

/// Ruta de reparto: agrupa pedidos por día, bloque y sector
model DeliveryRoute {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  date       DateTime @db.Date
  /// manana | tarde
  slot       String?
  sector     String?
  driverName String?
  /// planificada | en_ruta | completada
  status     String   @default("planificada")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId, date])
  @@map("delivery_routes")
}

/// Cliente de reparto (por teléfono), independiente del login de la tienda
model DeliveryCustomer {
  id               String    @id @default(cuid())
  tenantId         String
  name             String
  /// Solo dígitos, ej. 56912345678
  phone            String
  address          String?
  commune          String?
  recurring        Boolean   @default(false)
  /// semanal | quincenal | mensual
  frequency        String?
  nextDeliveryDate DateTime? @db.Date
  lastDeliveredAt  DateTime?
  lastReminderAt   DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders          Order[]
  bottleMovements BottleMovement[]

  @@unique([tenantId, phone])
  @@index([tenantId, recurring, nextDeliveryDate])
  @@map("delivery_customers")
}

/// Auditoría de cambios de despacho por pedido
model OrderEvent {
  id         String   @id @default(cuid())
  tenantId   String
  orderId    String
  /// asignado | en_ruta | entregado | no_entregado | nota
  type       String
  fromStatus String?
  toStatus   String?
  note       String?
  actorEmail String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([orderId])
  @@map("order_events")
}

/// Libro de envases retornables: salida (entregados) y entrada (devueltos)
model BottleMovement {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  orderId    String?
  /// out = entregado al cliente · in = devuelto
  direction  String
  quantity   Int
  /// entrega | devolucion | ajuste
  reason     String   @default("entrega")
  note       String?
  actorEmail String?
  createdAt  DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer DeliveryCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerId])
  @@index([orderId])
  @@map("bottle_movements")
}
