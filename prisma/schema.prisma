// Multi-tenant ecommerce — Phase 1–3
// Future: Customer accounts, production WebPay hardening

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  tagline   String?
  about     String?
  /// Hex brand color, e.g. #0B6E4F
  primaryColor   String  @default("#0B6E4F")
  secondaryColor String  @default("#1B9AAA")
  logoUrl        String?
  phone          String?
  email          String?
  whatsapp       String?
  address        String?
  city           String?
  region         String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  adminUsers        AdminUser[]
  products          Product[]
  deliveryZones     DeliveryZone[]
  orders            Order[]
  webpayCredential  WebPayCredential?

  @@map("tenants")
}

/// Per-tenant WebPay Plus credentials (API key encrypted at rest)
model WebPayCredential {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  commerceCode    String
  /// AES-GCM ciphertext (base64url)
  apiKeyEncrypted String
  /// integration | production
  environment     String   @default("integration")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("webpay_credentials")
}

model AdminUser {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         String   @default("admin") // admin | super_admin (future)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("admin_users")
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  /// Price in Chilean pesos (CLP), whole pesos
  priceClp    Int
  imageUrl    String?
  /// Optional stock; null = not tracked
  stock       Int?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
  @@map("products")
}

model DeliveryZone {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  /// Comunas covered, comma-separated stub
  communes    String
  /// Delivery cost in CLP; 0 = gratis
  costClp     Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId])
  @@map("delivery_zones")
}

/// pending → paid/failed/cancelled via WebPay commit
model Order {
  id               String   @id @default(cuid())
  tenantId         String
  deliveryZoneId   String?
  status           String   @default("pending") // pending | paid | failed | cancelled
  customerName     String
  customerPhone    String
  customerAddress  String
  customerNotes    String?
  /// Snapshot of zone name at order time
  deliveryZoneName String?
  subtotalClp      Int
  shippingClp      Int      @default(0)
  totalClp         Int
  /// Transbank buy_order (≤26 chars, unique per commerce)
  buyOrder         String?
  webpayToken      String?
  webpayStatus     String?
  webpayResponseCode Int?
  webpayAuthorizationCode String?
  webpayPaymentTypeCode   String?
  webpayCardLast4  String?
  /// mock | sandbox
  paymentProvider  String?
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@unique([tenantId, buyOrder])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([webpayToken])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String?
  /// Snapshot fields so catalog edits don't rewrite history
  productName  String
  productSlug  String
  unitPriceClp Int
  quantity     Int
  lineTotalClp Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}
