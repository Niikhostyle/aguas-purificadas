# Local / production template — copy to .env (never commit real secrets)
DATABASE_URL="postgresql://aguas:aguas_dev@localhost:5432/aguas_purificadas?schema=public"
APP_URL="http://127.0.0.1:43123"
DEFAULT_TENANT_SLUG=""
WEBPAY_MODE="mock"
ADMIN_SESSION_SECRET="change-me-long-random-at-least-32-chars"
CUSTOMER_SESSION_SECRET="change-me-customer-session-secret"
WEBPAY_CREDENTIALS_KEY="change-me-32-bytes-hex-or-passphrase"
CREDENTIALS_ENCRYPTION_KEY="change-me-32-bytes-hex-or-passphrase"

# Dev seed only (prisma/seed.ts) — use strong unique values; never production passwords here as defaults
SEED_SUPER_ADMIN_EMAIL="super@example.local"
SEED_SUPER_ADMIN_PASSWORD="replace-with-strong-dev-password"
SEED_DEMO_ADMIN_EMAIL="admin@demo.local"
SEED_DEMO_ADMIN_PASSWORD="replace-with-strong-dev-password"

# docker-compose.prod.yml — set RUN_SEED=false after first secure bootstrap
POSTGRES_PASSWORD="change-me-strong-db-password"
RUN_SEED="false"
