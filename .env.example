DATABASE_URL="postgresql://aguas:aguas_dev@localhost:5432/aguas_purificadas?schema=public"
DEFAULT_TENANT_SLUG="rio-claro"
ADMIN_SESSION_SECRET="dev-session-secret-change-in-production"

# Public base URL used as WebPay return_url
APP_URL="http://127.0.0.1:43123"

# auto | sandbox | mock
# auto/sandbox: Transbank Integration (real sandbox) using tenant DB creds, env, or SDK defaults
# mock: local simulator at /pago/mock/[orderId] (no Transbank call)
WEBPAY_MODE="auto"

# Optional overrides (otherwise seed stores Integration commerce defaults encrypted per tenant)
# WEBPAY_COMMERCE_CODE="597055555532"
# WEBPAY_API_KEY="579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C"

# AES key material for encrypting api keys at rest (defaults to ADMIN_SESSION_SECRET)
WEBPAY_CREDENTIALS_KEY="dev-webpay-credentials-key"
