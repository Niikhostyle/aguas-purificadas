{% extends "layout_public.html.twig" %}

{% block meta_title %}{{ 'Ingresar'|trans }}{% endblock %}
{% block meta_description %}{{ 'Ingresa para ver tu tienda MiBidón, tus facturas y pagar tu plan.'|trans }}{% endblock %}

{% block body_class %}page-login{% endblock %}
{% block body %}
<main class="mb-auth">
    <div class="mb-auth-card">
        {% if public_logo_url and settings.login_page_show_logo %}
            <a class="mb-auth-logo" href="{{ '/'|url }}">
                <img src="{{ public_logo_url }}" alt="{{ company.name }}" height="48">
            </a>
        {% endif %}
        <div class="card">
            <div class="card-body">
                <h1>{{ 'Ingresa a tu cuenta'|trans }}</h1>
                <p class="mb-auth-sub">{{ 'Administra tu plan, tu tienda y tus pagos.'|trans }}</p>
                {{ render_widgets('client.page.login.form.before') }}
                <form method="post" action="{{ 'client/login'|api_url(role: 'guest') }}" class="auth" {{ fb_api_form({redirect: redirect_uri|default('/')|url}) }}>
                    <div class="mb-3">
                        <label class="form-label" for="email">{{ 'Correo electrónico'|trans }}</label>
                        <input class="form-control form-control-lg" id="email" type="email" placeholder="tucorreo@empresa.cl" name="email" value="{{ request.email }}" required="required" autocomplete="email" autofocus>
                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <label class="form-label" for="password">{{ 'Contraseña'|trans }}</label>
                            {% if settings.show_password_reset_link %}
                                <a class="small" href="{{ 'password-reset'|url }}">{{ '¿La olvidaste?'|trans }}</a>
                            {% endif %}
                        </div>
                        <input class="form-control form-control-lg" id="password" type="password" name="password" required="required" autocomplete="current-password">
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">{{ 'Ingresar'|trans }}</button>
                </form>
                {{ render_widgets('client.page.login.form.after') }}
                {% if settings.show_signup_link %}
                    <p class="mb-auth-links mb-0">
                        {{ '¿Aún no tienes cuenta?'|trans }}
                        <a class="fw-semibold" href="{{ 'signup'|url }}">{{ 'Crear cuenta'|trans }}</a>
                    </p>
                {% endif %}
            </div>
        </div>
        <p class="mb-auth-back"><a href="{{ 'order'|url }}">{{ 'Ver planes y precios'|trans }}</a> · <a href="https://mibidon.cl">mibidon.cl</a></p>
    </div>
</main>
{% endblock %}
