{% set mibidon_store = client.mibidon_store({ 'order_id': order.id }) %}
{% if mibidon_store %}
    <div class="card-body border-top">
        <h5 class="mb-3">{{ 'Tu tienda MiBidón'|trans }}</h5>
        {% if mibidon_store.url %}
            <table class="table table-sm mb-3">
                <tbody>
                <tr>
                    <td><label>{{ 'Tienda online'|trans }}</label></td>
                    <td><a href="{{ mibidon_store.url }}" target="_blank" rel="noopener">{{ mibidon_store.url }}</a></td>
                </tr>
                <tr>
                    <td><label>{{ 'Panel de administración'|trans }}</label></td>
                    <td><a href="{{ mibidon_store.admin_url }}" target="_blank" rel="noopener">{{ mibidon_store.admin_url }}</a></td>
                </tr>
                </tbody>
            </table>
            {% if order.status == 'active' %}
                <a class="btn btn-primary btn-sm"
                   {{ fb_api_link({href: 'mibidon/invite'|api_url(query: {order_id: order.id}), callback: 'onMibidonInvite'}) }}>{{ 'Crear o restablecer contraseña del panel'|trans }}</a>
                <script>window.onMibidonInvite = (url) => { if (typeof url === 'string' && url.indexOf('https://') === 0) { window.location = url; } };</script>
            {% else %}
                <p class="text-secondary mb-0">{{ 'La tienda está suspendida mientras la orden no esté activa.'|trans }}</p>
            {% endif %}
        {% elseif order.status == 'active' %}
            <p class="text-secondary mb-0">
                {% if mibidon_store.has_error %}
                    {{ 'Estamos terminando de preparar tu tienda. Te avisaremos por correo; si tarda más de unas horas, abre un ticket.'|trans }}
                {% else %}
                    {{ 'Tu tienda se está creando. Recarga esta página en unos segundos.'|trans }}
                {% endif %}
            </p>
        {% else %}
            <p class="text-secondary mb-0">{{ 'Tu tienda se creará automáticamente cuando se confirme el pago.'|trans }}</p>
        {% endif %}
    </div>
{% endif %}
